{
  "name": "keep-pdf",
  "version": "0.1.0",
  "description": "PDF viewer with annotations for Vue 3",
  "type": "module",
  "main": "./dist/keep-pdf.umd.cjs",
  "module": "./dist/keep-pdf.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/keep-pdf.js",
      "require": "./dist/keep-pdf.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "konva": "^9.3.0",
    "naive-ui": "^2.38.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.379",
    "vue": "^3.5.0",
    "vue-konva": "^3.0.2"
  },
  "devDependencies": {
    "@iconify-json/ant-design": "^1.2.5",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.3",
    "highlight.js": "^11.12.0",
    "konva": "^9.3.0",
    "naive-ui": "^2.38.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.379",
    "typescript": "^5.9.3",
    "unplugin-icons": "^22.0.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.0.0",
    "vue": "^3.5.26",
    "vue-konva": "^3.0.2",
    "vue-tsc": "^2.0.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "pdf",
    "pdf-viewer",
    "annotations",
    "konva"
  ],
  "license": "MIT",
  "dependencies": {}
}
